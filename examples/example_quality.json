{
  "_comment": "Quality + Momentum factor example batch.",
  "defaults": {
    "instrumentType": "EQUITY",
    "region": "USA",
    "universe": "TOP3000",
    "delay": 1,
    "decay": 4,
    "neutralization": "INDUSTRY",
    "truncation": 0.08,
    "pasteurization": "ON",
    "unitHandling": "VERIFY",
    "nanHandling": "ON",
    "language": "FASTEXPR",
    "visualization": false,
    "auto_submit": false,
    "submission_mode": "qualified_only",
    "min_sharpe": 1.25,
    "min_fitness": 1.0,
    "max_turnover": 0.30
  },
  "alphas": [
    {
      "name": "ROE_Momentum",
      "expression": "group_rank(ts_rank(operating_income / equity, 126), subindustry)",
      "family": "profitability",
      "decay": 0
    },
    {
      "name": "EPS_Estimate_Trend",
      "expression": "group_rank(ts_rank(est_eps / close, 252), industry)",
      "family": "analyst",
      "decay": 4
    },
    {
      "name": "FCF_Yield_Quality",
      "expression": "group_rank(ts_rank(free_cash_flow_reported_value / equity, 126), industry)",
      "family": "cashflow",
      "decay": 0
    },
    {
      "name": "BP_to_Price_Value",
      "expression": "group_rank(ts_rank(book_value_per_share_reported_value / close, 252), sector)",
      "family": "value",
      "decay": 4
    },
    {
      "name": "Quality_Composite_3F",
      "expression": "roe = group_rank(ts_rank(operating_income / equity, 252), subindustry);\neps = group_rank(ts_rank(est_eps / close, 252), industry);\nfcf = group_rank(ts_rank(free_cash_flow_reported_value / equity, 252), industry);\nsignal = 0.40 * roe + 0.35 * eps + 0.25 * fcf;\nrank(group_neutralize(signal, subindustry))",
      "family": "profitability_analyst_cashflow",
      "decay": 4,
      "neutralization": "SUBINDUSTRY"
    }
  ]
}
